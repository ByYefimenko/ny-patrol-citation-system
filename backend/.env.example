# Copy this file to .env and fill in your local values.

# MySQL connection string used by SQLAlchemy
DATABASE_URL=mysql+mysqlconnector://root:password@localhost/ny_patrol_traffic_db

# JWT settings
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30

# Frontend origin
CORS_ORIGINS=http://127.0.0.1:5173
